
@model StajEvrakDogrulama.Models.Login

@{
    ViewData["Title"] = "Giriş Yap";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-5">

            <div class="card shadow p-4">

                <h2 class="text-center mb-4">
                    Staj Evrak Doğrulama
                </h2>

                <h5 class="text-center mb-4">
                    Kullanıcı Girişi
                </h5>

                <form asp-controller="Giris"
                      asp-action="Index"
                      method="post">

                    <div asp-validation-summary="All"
                         class="text-danger mb-3">
                    </div>

                    <div class="mb-3">
                        <label asp-for="KullaniciAdi"
                               class="form-label">
                            Kullanıcı Adı veya E-posta
                        </label>

                        <input asp-for="KullaniciAdi"
                               class="form-control"
                               placeholder="Kullanıcı adınızı giriniz" />
                    </div>

                    <div class="mb-3">
                        <label asp-for="Sifre"
                               class="form-label">
                            Şifre
                        </label>

                        <input asp-for="Sifre"
                               type="password"
                               class="form-control"
                               placeholder="Şifrenizi giriniz" />
                    </div>

                    <button type="submit"
                            class="btn btn-primary w-100">
                        Giriş Yap
                    </button>
                   
                    <div class="text-center mt-3">
                        <a asp-controller="Kayit" asp-action="Index">
                            Hesabın yok mu? -- Kayıt Ol
                        </a>
                    </div>
                </form>

            </div>

        </div>
    </div>
</div>
