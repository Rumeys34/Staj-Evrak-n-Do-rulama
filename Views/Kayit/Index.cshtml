
@model StajEvrakDogrulama.Models.Kayit

@{
    ViewData["Title"] = "Kayıt Ol";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">

            <div class="card shadow p-4">

                <h2 class="text-center mb-4">
                    Staj Evrak Doğrulama
                </h2>

                <h5 class="text-center mb-4">
                    Öğrenci Kayıt Formu
                </h5>

                <form asp-controller="Kayit"
                      asp-action="Index"
                      method="post">

                    <div asp-validation-summary="All"
                         class="text-danger mb-3">
                    </div>

                    <div class="mb-3">
                        <label asp-for="AdSoyad" class="form-label">
                            Ad Soyad
                        </label>
                        <input asp-for="AdSoyad" class="form-control" />
                    </div>

                    <div class="mb-3">
                        <label asp-for="KullaniciAdi" class="form-label">
                            Kullanıcı Adı
                        </label>
                        <input asp-for="KullaniciAdi" class="form-control" />
                    </div>

                    <div class="mb-3">
                        <label asp-for="Eposta" class="form-label">
                            E-posta
                        </label>
                        <input asp-for="Eposta" class="form-control" />
                    </div>

                    <div class="mb-3">
                        <label asp-for="Sifre" class="form-label">
                            Şifre
                        </label>
                        <input asp-for="Sifre"
                               type="password"
                               class="form-control" />
                    </div>

                    <div class="mb-3">
                        <label asp-for="SifreTekrar" class="form-label">
                            Şifre Tekrar
                        </label>
                        <input asp-for="SifreTekrar"
                               type="password"
                               class="form-control" />
                    </div>

                    <button type="submit"
                            class="btn btn-primary w-100">
                        Kayıt Ol
                    </button>

                    <div class="text-center mt-3">
                        <a asp-controller="Giris" asp-action="Index">
                            Zaten hesabım var, giriş yap
                        </a>
                    </div>

                </form>

            </div>
        </div>
    </div>
</div>
