@{
    ViewData["Title"] = "Admin Paneli";
}

<div class="container mt-5">

    <h2 class="mb-4">Admin Paneli</h2>

    <div class="card shadow p-4 mb-4">
        <h4>Yönetici Ekranı</h4>
        <p>
            Staj Evrak Doğrulama ve Yönetim Sistemi
            yönetici paneline hoş geldiniz.
        </p>
    </div>

    <div class="row">

        <div class="col-md-6 mb-3">
            <div class="card p-4 h-100">
                <h5>📁 Veri Seti Yükle</h5>
                <p>
                    Test amaçlı öğrenci veri setini
                    sisteme yükleyebilirsiniz.
                </p>
            </div>
        </div>

        <div class="col-md-6 mb-3">
            <div class="card p-4 h-100">
                <h5>📄 Tüm Başvurular</h5>
                <p>
                    Öğrencilerin yüklediği staj
                    başvurularını görüntüleyebilirsiniz.
                </p>
            </div>
        </div>

        <div class="col-md-6 mb-3">
            <div class="card p-4 h-100">
                <h5>✅ Tamamlanan Belgeler</h5>
                <p>
                    Tamamlanmış staj evraklarını
                    inceleyebilirsiniz.
                </p>
            </div>
        </div>

        <div class="col-md-6 mb-3">
            <div class="card p-4 h-100">
                <h5>📑 Ek-17 Oluştur</h5>
                <p>
                    Tamamlanan başvurulardan
                    Ek-17 belgesi oluşturabilirsiniz.
                </p>
            </div>
        </div>

    </div>

    <div class="mt-4">
        <a asp-controller="Giris"
           asp-action="Cikis"
           class="btn btn-danger">
            Çıkış Yap
        </a>
    </div>

</div>